  Lines:
  - Id: release
    Speaker: {fileID: 11400000, guid: 45efbe9b1a604d841861ad84cfe9b8f9, type: 2}
    Text: You made it. Cut these bonds, quickly.
    Next: 
    Options:
    - Text: You're safe. Come with me.
      Next: thanks
      Condition: 
      Command: companion.release
  - Id: thanks
    Speaker: {fileID: 11400000, guid: 45efbe9b1a604d841861ad84cfe9b8f9, type: 2}
    Text: I thought nobody would find me. Let's get out of here.
    Next: 
    Options: []
