  m_Name: contact-conversation
  m_EditorClassIdentifier: DemonViglu.Dialogue.Unity::DemonViglu.Dialogue.Unity.DialogueAsset
  Lines:
  - Id: opening
    Speaker: {fileID: 11400000, guid: 3f9c287e6c1b21c47b867adc5a0384fe, type: 2}
    Text: The watch post has kept its silence. All I ask is that our envoy comes home alive.
    Next: 
    Options:
    - Text: I'll follow the trail and find them.
      Next: 
      Condition: assignment.new
      Command: assignment.accept
    - Text: The envoy is safe. I'll leave them in your care.
      Next: 
      Condition: envoy.ready
      Command: assignment.handover
    - Text: Not yet.
      Next: 
      Condition: 
      Command: 
