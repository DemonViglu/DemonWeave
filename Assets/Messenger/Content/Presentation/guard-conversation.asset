  m_Script: {fileID: 11500000, guid: 763915b47424cfd488dcce602a45e74a, type: 3}
  m_Name: guard-conversation
  m_EditorClassIdentifier: DemonViglu.Dialogue.Unity::DemonViglu.Dialogue.Unity.DialogueAsset
  Lines:
  - Id: opening
    Speaker: {fileID: 11400000, guid: e3674c35379ccb84aa26a2cf11292eb6, type: 2}
    Text: The envoy stays here. If you wish to negotiate, there is a price. Otherwise,
      keep away from the tunnel.
    Next: 
    Options:
    - Text: Offer a deposit and negotiate.
      Next: decision
      Condition: route.negotiate
      Command: route.negotiate
    - Text: Take the tunnel route.
      Next: 
      Condition: route.infiltrate
      Command: route.infiltrate
    - Text: Leave.
      Next: 
      Condition: 
      Command: 
  - Id: decision
    Speaker: {fileID: 11400000, guid: e3674c35379ccb84aa26a2cf11292eb6, type: 2}
    Text: You have my answer. What will you do?
    Next: 
    Options:
    - Text: Use the tunnel instead.
      Next: 
      Condition: route.infiltrate
      Command: route.infiltrate
    - Text: Leave and assess the situation.
      Next: 
      Condition: 
      Command: 
